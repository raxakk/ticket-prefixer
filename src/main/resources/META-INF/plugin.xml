<idea-plugin>
    <!-- Immutable once published to the JetBrains Marketplace. It still carries the
         plugin's original name, TicketStamp; changing it would make this a different
         plugin and cut the existing installations off from updates. -->
    <id>io.github.raxakk.ticketstamp</id>

    <!-- name, version, vendor, description and idea-version are patched in by
         the Gradle plugin from build.gradle.kts. -->

    <depends>com.intellij.modules.platform</depends>
    <depends>Git4Idea</depends>

    <extensions defaultExtensionNs="com.intellij">
        <applicationService
                serviceImplementation="io.github.raxakk.ticketprefixer.TicketPrefixerSettings"/>

        <applicationConfigurable
                instance="io.github.raxakk.ticketprefixer.TicketPrefixerConfigurable"
                displayName="Ticket Prefixer"
                id="io.github.raxakk.ticketstamp.settings"
                parentId="vcs"/>

        <notificationGroup
                id="Ticket Prefixer"
                displayType="BALLOON"/>
    </extensions>

    <actions>
        <!-- Kept from the original name so that keyboard shortcuts users have assigned
             to this action survive the rename. -->
        <action
                id="TicketStamp.InsertTicket"
                class="io.github.raxakk.ticketprefixer.TicketPrefixerAction"
                text="Insert Ticket Number from Branch"
                description="Prepends the ticket number from the current Git branch to the commit message"
                icon="AllIcons.Vcs.Branch">
            <add-to-group group-id="Vcs.MessageActionGroup" anchor="first"/>
        </action>
    </actions>
</idea-plugin>
